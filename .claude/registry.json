{
  "version": 2,

  "project": {
    "name": "AnywhereParty",
    "type": "browser-extension",
    "stage": "late-prototype",
    "architecture": "three-layer-message-passing",
    "languages": ["typescript"],
    "frameworks": ["react", "mui", "tailwind", "webpack", "vitest"]
  },

  "knowledge": {
    "context_summary": ".claude/docs/context-summary.md",
    "current_state": ".claude/docs/current-state.md",
    "project_memory": ".claude/docs/project-memory.md",
    "architecture_decisions": ".claude/docs/architecture-decisions.md",
    "troubleshooting": ".claude/docs/troubleshooting.md",
    "implementation_plan": "plan.md",
    "knowledge_map": ".claude/docs/knowledge-map.md",
    "governance": ".claude/docs/governance.md",
    "compression_policy": ".claude/docs/compression-policy.md",
    "repository_profile": ".claude/docs/repository-profile.md"
  },

  "loading_order": [
    "context_summary",
    "current_state",
    "project_memory",
    "architecture_decisions",
    "implementation_plan"
  ],

  "authoritative_sources": {
    "repository_guidance": "CLAUDE.md",
    "project_memory": ".claude/docs/project-memory.md",
    "implementation_plan": "plan.md",
    "specs": ".kiro/specs/watch-party-extension/requirements.md"
  },

  "rules": {
    "prefer_authoritative_sources": true,
    "prefer_rewrite_over_append": true,
    "avoid_duplicate_knowledge": true,
    "compress_before_expanding": true
  }
}
