{
  "name": "watch-party-extension",
  "version": "1.0.0",
  "description": "Cross-browser watch party extension for synchronized video viewing",
  "main": "dist/background.js",
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "webpack --mode=production --env browser=chrome",
    "build:firefox": "webpack --mode=production --env browser=firefox",
    "build:dev": "npm run build:dev:chrome && npm run build:dev:firefox",
    "build:dev:chrome": "webpack --mode=development --env browser=chrome",
    "build:dev:firefox": "webpack --mode=development --env browser=firefox",
    "watch": "webpack --mode=development --watch --env browser=chrome",
    "watch:firefox": "webpack --mode=development --watch --env browser=firefox",
    "lint:fix": "node scripts/run-with-summary.js eslint src/**/*.{ts,tsx} --max-warnings=0 --fix",
    "lint": "node scripts/run-with-summary.js eslint src/**/*.{ts,tsx} --max-warnings=0",
    "typecheck": "node scripts/run-with-summary.js tsc --noEmit",
    "test": "node scripts/run-with-summary.js vitest --run",
    "test:watch": "node scripts/run-with-summary.js vitest watch",
    "test:coverage": "node scripts/run-with-summary.js vitest --run --coverage",
    "stryker": "node scripts/run-with-summary.js stryker run",
    "test:mutation": "node scripts/run-with-summary.js stryker run",
    "test:runtime-fixes": "node scripts/test-runtime-fixes.js",
    "format": "prettier --write src/**/*.{ts,tsx,json,css}",
    "format:check": "prettier --check src/**/*.{ts,tsx,json,css}",
    "prepare": "husky install",
    "server:install": "cd server && npm install",
    "server:start": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "server:test": "cd server && npm test",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run watch\"",
    "dev:setup": "npm install && npm run server:install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/chrome": "^0.2.5",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.25",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "webextension-polyfill": "^0.12.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
