# Dockerfile for Feature Flags Service
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache curl redis

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy feature flags service files
COPY feature-flags-server.js ./
COPY feature-flags.js ./

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Change ownership
RUN chown -R nodejs:nodejs /app
USER nodejs

# Expose port
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3002/health || exit 1

# Start feature flags server
CMD ["node", "feature-flags-server.js"]