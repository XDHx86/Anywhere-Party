# Environment Configuration Template
# Copy this file to .env and update with your values

# Application Environment
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://watchparty:watchparty_dev@localhost:5432/watchparty
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT=30000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=10000

# Security
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your-32-character-encryption-key
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,chrome-extension://*,moz-extension://*
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS_PER_IP=10
WS_MESSAGE_SIZE_LIMIT=1048576

# Room Configuration
ROOM_MAX_PARTICIPANTS=50
ROOM_CLEANUP_INTERVAL=300000
ROOM_INACTIVE_TIMEOUT=1800000
ROOM_MAX_DURATION=86400000

# TURN Server Configuration (WebRTC)
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-password
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# External Services
OPENSUBTITLES_API_KEY=your-opensubtitles-api-key
OPENSUBTITLES_USER_AGENT=WatchPartyExtension v1.0
OPENSUBTITLES_RATE_LIMIT=40

# Feature Flags
FEATURE_FLAGS_ENDPOINT=http://localhost:3002/flags
FEATURE_FLAGS_CACHE_TTL=300
FEATURE_FLAGS_DEFAULT_ENABLED=false

# Monitoring and Telemetry
TELEMETRY_ENABLED=false
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# Logging
LOG_FORMAT=json
LOG_FILE_PATH=./logs/server.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# File Upload Limits
MAX_SUBTITLE_FILE_SIZE=1048576
MAX_ANNOTATION_SIZE=524288
ALLOWED_SUBTITLE_FORMATS=srt,vtt
UPLOAD_TEMP_DIR=./tmp

# Security Headers
HELMET_ENABLED=true
CSP_ENABLED=true
HSTS_MAX_AGE=31536000

# Development Only
DEV_MOCK_TURN_SERVER=false
DEV_DISABLE_AUTH=false
DEV_ENABLE_DEBUG_ROUTES=false