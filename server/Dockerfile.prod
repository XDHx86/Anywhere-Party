# Production Dockerfile for Watch Party Extension Server
# Single-stage build — server is plain JS, no compilation needed.
# Only runtime files and production dependencies are included.

FROM node:22-alpine

# Signal handling as PID 1 (node ignores SIGTERM when running as PID 1)
RUN apk add --no-cache dumb-init

WORKDIR /app
ENV NODE_ENV=production

# Install production dependencies with lockfile
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy only the runtime entrypoint. local-relay.js is a self-contained
# in-memory relay (requires only ws and uuid). room-manager.js, database/,
# and cache/ are not used by this service and reference pg/ioredis/bcrypt.
COPY local-relay.js ./

# Non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs
EXPOSE 3001

# TCP liveness check — local-relay is a pure WebSocket server (no HTTP /health).
# Reads PORT (default 8080) so the check always targets the actual listen port.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD node -e "const p=process.env.PORT||8080;require('net').connect(p,'localhost',()=>process.exit(0)).on('error',()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "local-relay.js"]
